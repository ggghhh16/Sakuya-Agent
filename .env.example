# Copy to .env. Secrets stay on the backend and are never sent to the UI.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
TAVILY_API_KEY=
GITHUB_TOKEN=
# Optional read-only research domains, comma-separated. localhost/private IPs are always rejected.
RESEARCH_ALLOWED_HOSTS=docs.langchain.com,github.com,raw.githubusercontent.com,api.github.com,arxiv.org,export.arxiv.org,docs.python.org,fastapi.tiangolo.com,react.dev,developer.mozilla.org
EXPERIMENT_IMAGE=python:3.12-slim
# Local authenticated workspace. Keep the default loopback bind.
SAKUYA_PORT=8120

# Cloudflare Turnstile: register the hostname used to open this app.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# SMTP must use TLS. Use an app password where your mail provider requires one.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Set to 1 only when serving the app over HTTPS; local HTTP requires 0.
SAKUYA_COOKIE_SECURE=0
